<?xml version="1.0" encoding="utf-8"?>
<!--
  Grants the privileged (signature|privileged) permissions the app needs to record messenger
  (VoIP) calls in-process. Applies only because the module installs the app as a privileged
  system app (system/priv-app/AutoResponder). These three are the ONLY signature|privileged
  permissions the app declares, so the allowlist is complete (no strict-mode boot issue).

  See the app's NOTICE.md — the capture mechanism is derived from CallVault (GPL-3.0).
-->
<permissions>
    <privapp-permissions package="com.davnozdu.autoresponder">
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT"/>
        <permission name="android.permission.CAPTURE_VOICE_COMMUNICATION_OUTPUT"/>
        <permission name="android.permission.MODIFY_AUDIO_ROUTING"/>
    </privapp-permissions>
</permissions>
